# Local-only reference material — contains a live session cookie jar. Never commit.
cookies.txt

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# The site itself installs nothing; these come from the wrangler + Capacitor toolchains.
node_modules/
.wrangler/
.dev.vars
dist/
*.log

# ---------------------------------------------------------------- native app
# Generated by `npm run build` from the repo root sources. Editing www/ is always a
# mistake: the next build wipes it. Note it is NOT a byte-copy of the root — the
# build strips the Google Fonts CDN links and vendors the faces (see MOBILE.md).
www/

# Portable JDK 21 + Android SDK, fetched by hand so an APK could be built without a
# system-wide Android Studio. ~6.5 GB of third-party binaries, fully reproducible
# from MOBILE.md §4. GitHub also hard-rejects any single file over 100 MB.
.toolchain/

# Build outputs. Reproducible from `gradlew assembleDebug`; ~30 MB of the 34 MB
# android/ tree is this. The native projects themselves ARE committed.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/.idea/
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/
ios/DerivedData/
*.apk
*.aab

# Signing material. A leaked keystore cannot be revoked — it burns the app listing,
# permanently. See MOBILE.md §5.5.
*.keystore
*.jks
key.properties
